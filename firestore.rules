rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Services collection: public read, write for admin/system
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Carousel collection: public read, write for admin/system
    match /carousel/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin setup / config flag
    match /admin_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Daily slots locks: to prevent double-booking atomically
    match /slot_locks/{lockId} {
      allow read: if true;
      allow write: if true;
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerPhone is string
                    && request.resource.data.date is string
                    && request.resource.data.startTime is string
                    && request.resource.data.endTime is string;
      allow update, delete: if true;
    }
  }
}
